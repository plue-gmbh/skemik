# BEGIN Skemik
# Every request reaches index.php, except view/'s static files. No other .php
# runs, so config.php answers 403 and never its values.
# This asks the server and guarantees nothing: nginx, or Apache without
# AllowOverride, ignores it, so nothing the install holds depends on it.
# The Authorization line passes a key to PHP, which FastCGI otherwise drops.
# Some hosts reach the domain's folder through a rewrite of their own. For them,
# RewriteBase maps index.php back to an address, and L instead of END lets that
# rewrite run again. Otherwise PHP is handed a file that is not there.
# An update replaces only what stands between BEGIN Skemik and END Skemik.
# A host's own line, like the one picking the PHP version, goes outside them.

<FilesMatch "\.php$">
  Require all denied
</FilesMatch>

<Files "index.php">
  Require all granted
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^view/[\w/.-]+\.(css|js|woff2|ico|png|webmanifest)$ - [L]
  RewriteRule ^(?!index\.php$) index.php [L]
</IfModule>
# END Skemik
